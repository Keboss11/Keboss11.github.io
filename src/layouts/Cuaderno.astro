---
import '../styles/cuaderno.css';
import Brujula from '../components/Brujula.astro';
import { CUADERNO } from '../config';
import { vecinos } from '../lib/cuaderno';

interface Props {
  titulo?: string;
  descripcion?: string;
}
const { titulo, descripcion = CUADERNO.descripcion } = Astro.props;
const path = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const v = await vecinos(path);
const tituloPagina = titulo ? `${titulo} · ${CUADERNO.titulo}` : `${CUADERNO.titulo} · ${CUADERNO.autor}`;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tituloPagina}</title>
    <meta name="description" content={descripcion} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Caveat:wght@500;700&family=JetBrains+Mono:wght@400;600&family=Literata:ital,opsz,wght@0,7..72,400;0,7..72,600;1,7..72,400&family=Special+Elite&display=swap" rel="stylesheet" />
    <script is:inline>
      try {
        document.documentElement.dataset.theme = localStorage.getItem('tema') || (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
      } catch (e) {}
    </script>
  </head>
  <body>
    <header class="top">
      <a class="brand" href="/">{CUADERNO.titulo.toUpperCase()} · Nº {CUADERNO.numero}</a>
      <nav>
        <a href="/">índice</a>
        <button id="anim" type="button">animaciones</button>
        <button id="tema" type="button">noche</button>
      </nav>
    </header>

    <main class="stage">
      <div class="pages" id="pages" data-idx={v.idx}>
        <div class="page left" id="L">
          <div class="pc"><slot name="izquierda" /></div>
          <span class="pnum">{v.pagina}</span>
        </div>
        <div class="page right" id="R">
          <div class="seam"></div>
          <div class="pc"><slot /></div>
          <span class="pnum">{v.pagina + 1}</span>
        </div>
        {v.prev && <a class="dogear prev" href={v.prev} aria-label="Página anterior"><span>← atrás</span></a>}
        {v.next && <a class="dogear next" href={v.next} aria-label="Página siguiente"><span>pasa página →</span></a>}
        <a class="ribbon" href="/" aria-label="Volver al índice"></a>
      </div>
    </main>
    <p class="help">pasa página con la esquina doblada, las flechas ← → del teclado o deslizando en el móvil</p>

    <template id="tpl-tapa">
      <div class="cover" role="button" tabindex="0" aria-label="Abrir el cuaderno">
        <i class="band"></i>
        <div class="label">
          <span class="tw">{CUADERNO.titulo.toUpperCase()} · Nº {CUADERNO.numero}</span>
          <b>{CUADERNO.etiqueta}</b>
          <span class="hand">de {CUADERNO.autor}</span>
        </div>
        <Brujula class="compass" />
        <span class="hint">toca para abrir</span>
      </div>
    </template>

    <script>
      import '../scripts/cuaderno';
    </script>
  </body>
</html>
