---
import Cuaderno from '../layouts/Cuaderno.astro';
import Subrayado from '../components/Subrayado.astro';
import Flecha from '../components/Flecha.astro';
---
<Cuaderno titulo="Página arrancada">
  <Fragment slot="izquierda">
    <div class="fields"><span>Nº<b>404</b></span><span>ESTADO<b>desaparecida</b></span></div>
    <span class="anno"><Flecha />alguien arrancó esta hoja… o nunca existió.</span>
  </Fragment>

  <div class="fields"><span>PÁGINA PERDIDA</span></div>
  <h1 class="title">Aquí faltaba una hoja</h1>
  <Subrayado />
  <p>La página que buscas no está en este cuaderno. Puede que la dirección esté mal escrita o que la entrada se haya movido.</p>
  <p><a href="/" class="hand" style="font-size:24px">→ volver al índice</a></p>
</Cuaderno>
