---
import Cuaderno from '../layouts/Cuaderno.astro';
import Subrayado from '../components/Subrayado.astro';
import Flecha from '../components/Flecha.astro';
import Brujula from '../components/Brujula.astro';
import { CUADERNO } from '../config';
import { ESTADOS, expediciones, entradas, orden, urlExp, urlEnt, expDe, fecha } from '../lib/cuaderno';

const exps = await expediciones();
const urls = await orden();
const todas = await entradas();
const ultimas = [...todas].sort((a, b) => b.data.fecha.getTime() - a.data.fecha.getTime()).slice(0, 5);
const cuantas = (id: string) => todas.filter((e) => expDe(e) === id).length;
---
<Cuaderno>
  <Fragment slot="izquierda">
    <div class="fields"><span>CUADERNO<b>Nº {CUADERNO.numero}</b></span><span>DESDE<b>{CUADERNO.desde}</b></span></div>
    <h3 class="tw" style="margin-top:6px">ESTE CUADERNO PERTENECE A</h3>
    <p class="owner">{CUADERNO.autor}</p>
    <p>Si lo encuentras, devuélvelo a <a href={CUADERNO.contacto.url}>{CUADERNO.contacto.texto}</a>. O léelo, que para eso está.</p>
    <span class="anno"><Flecha />{CUADERNO.presentacion}</span>
    <div class="legend">
      <h3 class="tw">LEYENDA</h3>
      <ul>
        <li><span class="sym">✓</span> expedición terminada</li>
        <li><span class="sym">~</span> en curso</li>
        <li><span class="sym">‖</span> en pausa</li>
        <li><span class="sym">○</span> por explorar</li>
      </ul>
    </div>
    <Brujula />
  </Fragment>

  <div class="fields"><span>ÍNDICE DE EXPEDICIONES</span></div>
  <h1 class="title">Proyectos</h1>
  <Subrayado />
  {exps.length === 0 ? (
    <p class="empty">
      Páginas en blanco… la primera expedición está por empezar.
      {import.meta.env.DEV && <><br /><code>Copia plantillas/expedicion.md en src/content/expediciones/</code></>}
    </p>
  ) : (
    <ol class="toc">
      {exps.map((x) => (
        <li>
          <a href={urlExp(x.id)}>
            <span class="sym" style={`color:${ESTADOS[x.data.estado].color}`}>{ESTADOS[x.data.estado].sym}</span>
            <span class="name">{x.data.titulo}</span>
            <span class="dots"></span>
            <span class="pg">p. {urls.indexOf(urlExp(x.id)) * 2 + 1}</span>
          </a>
          <small>{x.data.habitat} · {cuantas(x.id)} {cuantas(x.id) === 1 ? 'entrada' : 'entradas'}</small>
        </li>
      ))}
    </ol>
  )}
  {ultimas.length > 0 && (
    <>
      <h3 class="tw">ÚLTIMAS ENTRADAS</h3>
      <ul class="recent">
        {ultimas.map((e) => <li><span class="tw">{fecha(e.data.fecha)}</span><a href={urlEnt(e)}>{e.data.titulo}</a></li>)}
      </ul>
    </>
  )}
</Cuaderno>
